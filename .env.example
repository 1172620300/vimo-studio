# ===== LLM（OpenAI 兼容，例如 DeepSeek）=====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ===== 苍源网关：图像 + 视频 =====
CANGYUAN_BASE_URL=https://ai.cangyuansuanli.cn
CANGYUAN_API_KEY=
CANGYUAN_IMAGE_MODEL=gpt-image-2
CANGYUAN_VIDEO_API_KEY=
CANGYUAN_VIDEO_ENDPOINT=/v1/videos
CANGYUAN_VIDEO_MODEL=sd11-seedance-2.0
CANGYUAN_POLL_INTERVAL=5
CANGYUAN_POLL_MAX_ATTEMPTS=360
ENABLE_PAID_GENERATION=true

# ===== 服务 =====
DRAMA_PROFILE=default
DRAMA_API_TOKEN=change-me-to-a-long-random-string
DRAMA_MAX_JOBS=2
# DRAMA_DATA_DIR=/data
# DRAMA_WEBHOOK_URL=
