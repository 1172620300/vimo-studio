function phaseState(p,stages){const total=p.stages_total||[];const live=stages.filter(s=>total.includes(s));
  if(!live.length)return 'off';
  if(live.every(s=>p.stages_done.includes(s)))return 'done';
  if(p.state==='failed'&&live.includes(p.stage))return 'fail';
  if(p.state==='running'&&live.includes(p.stage))return 'cur';return ''}
const PH_SR={done:'已完成',cur:'进行中',fail:'失败',off:'确认后执行','':'未开始'}; syncDictionaries();
function renderProject(){const p=proj;if(!p)return;const b=p.bible||{},req=p.request||{},brief=p.brief||{};
  const mode=brief.mode||req.mode||'full';
  const title=b.title?`《${esc(b.title)}》`:esc(req.title||req.idea||p.id);
  const allEps=[...new Set(p.segments.map(s=>s.episode))].sort((a,b)=>a-b);
  const doneEps=((p.final&&p.final.episodes)||[]).map(e=>e.no);
  const track=phaseList().map(([name,stages],i)=>{let st=phaseState(p,stages);
    let sub=st==='off'?t('confirmExecute'):stages.map(s=>{const c=p.stages_done.includes(s)?'d':(p.stage===s&&p.state==='running')?'c':(p.stage===s&&p.state==='failed')?'f':'';return c?`<span class="${c}">${STAGE_CN[s]}</span>`:STAGE_CN[s]}).join('、');
    if(i>=3&&st==='done'&&allEps.length&&doneEps.length<allEps.length){st='';sub=t('out')+' '+doneEps.length+'/'+allEps.length+' '+t('episodes')}   // 按集出片：只出了部分集
    return `<li class="${st}"${st==='cur'?' aria-current="step"':''}><span class="node">${st==='done'?icon('check','width:14px;height:14px'):st==='fail'?icon('x','width:14px;height:14px'):i+1}</span><b>${name}</b><span class="sr-only">${PH_SR[st]}</span><div class="sub">${sub}</div></li>`}).join('');
  const leftEps=allEps.filter(e=>!doneEps.includes(e));
  const awaiting=p.state==='done'&&leftEps.length>0;
  const pct=Math.round(p.progress*100);
  let callout='';
  if(awaiting){const lc=epCost(p,leftEps);callout=`<div class="callout"><div><b>${doneEps.length?t('out')+' '+doneEps.length+'/'+allEps.length+' '+t('episodes'):t('promptReady')}</b><div class="muted small">${lang==='en'?`Remaining ${leftEps.length} episodes, ${lc.segs} clips, about ${fmtDur(lc.secs)}. Try episode ${leftEps[0]} first, then continue when ready.`:`剩余 ${leftEps.length} 集，${lc.segs} 段，约 ${fmtDur(lc.secs)}。建议先生成第 ${leftEps[0]} 集看效果，满意再继续；也可以在下方选任意一集单独生成。`}</div></div><div class="actions"><button class="btn acc" onclick="renderEps([${leftEps[0]}])">${t('episodeVideo').replace('this episode',t('episode',{n:leftEps[0]}))}</button>${leftEps.length>1?`<button class="btn" onclick="renderEps(null)">${t('generateRest',{n:leftEps.length})}</button>`:''}</div></div>`}
  else if(['failed','paused'].includes(p.state))callout=`<div class="callout bad" role="alert"><div><b>${p.state==='failed'?t('stageFail'):t('paused')}</b><div class="muted small">${esc(p.error||'')}</div></div><button class="btn acc" onclick="resumeJob()">${t('resumable')}</button></div>`;
  const tabs=[['overview',t('overview')],['assets',`${t('assets')} ${p.assets.length||''}`],['storyboard',`${t('storyboard')} ${p.segments.length||''}`],['video',t('video')],['log',t('logs')]];
