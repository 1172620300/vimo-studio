/* 集卡片：竖幅画框 + 大号集数；出片后画框里是这一集的真实画面 */
function episodeStrip(p){const b=p.bible||{};const eps=p.episodes.length?p.episodes:(b.episodes||[]);if(!eps.length)return '';
