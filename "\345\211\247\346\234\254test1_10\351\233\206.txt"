<!doctype html>
<html lang="zh-CN" translate="no">
<head>
<meta charset="utf-8">
<meta name="google" content="notranslate">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Vimo Studio · 短剧创作</title>
<link rel="icon" type="image/png" href="/assets/vimo-studio-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Space+Grotesk:wght@500;700&display=swap">
<style>
/* 设计令牌：深色 + 场记绿（品牌色 #D4FF3A）；对比度均按 WCAG 4.5:1 校核 */
:root{
  color-scheme:dark;
  --bg:#090b0a;--side:#0c0f0d;--card:#111513;--card2:#181d1a;--line:rgba(255,231,178,.10);--line2:rgba(255,231,178,.18);
  --ink:#eef2ec;--mute:rgba(238,242,236,.66);--faint:rgba(238,242,236,.54);
  --acc:#d4ff3a;--acc-ink:#0c1100;--acc-soft:rgba(212,255,58,.09);--acc-line:rgba(212,255,58,.42);
  --ok:#5be49b;--bad:#ff6b5e;--warn:#ffb547;
  --r-tile:6px;--r:8px;--r-lg:12px;--hit:40px;
  --font:"DM Sans","PingFang SC","HarmonyOS Sans SC","Noto Sans SC","Microsoft YaHei",system-ui,sans-serif;
  --display:"Space Grotesk","PingFang SC","HarmonyOS Sans SC","Microsoft YaHei",system-ui,sans-serif;
  --mono:ui-monospace,"SFMono-Regular",Consolas,Menlo,monospace;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{background:var(--bg);color:var(--ink);font:14px/1.6 var(--font);-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
a{color:inherit}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px;border-radius:4px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.ico{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.app{display:grid;grid-template-columns:236px minmax(0,1fr);min-height:100vh}

/* ---------- 侧栏 ---------- */
.side{background:var(--side);border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column;gap:14px;position:sticky;top:0;height:100vh}
.brand{display:flex;align-items:center;gap:10px;padding:0 6px;font:700 16px/1 var(--display);letter-spacing:-.2px}
.logo{width:28px;height:28px;border-radius:7px;background:var(--acc);color:var(--acc-ink);display:grid;place-items:center}
.btn-new{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:var(--hit);border:0;border-radius:var(--r);background:var(--ink);color:#0c0f0d;font-weight:700;cursor:pointer}
.btn-new:hover{background:#fff}
.nav{display:flex;flex-direction:column;gap:2px}
.nav button{display:flex;align-items:center;gap:10px;min-height:var(--hit);padding:0 10px;border-radius:var(--r);color:var(--mute);border:0;background:none;cursor:pointer;text-align:left;width:100%}
.nav button:hover,.nav button.on{background:var(--card2);color:var(--ink)}
.sec-t{font-size:12px;color:var(--faint);padding:0 10px}
.plist{flex:1;overflow:auto;display:flex;flex-direction:column;gap:2px;margin:0 -4px;padding:0 4px}
.pitem{display:flex;align-items:center;gap:8px;min-height:var(--hit);padding:4px 10px;border-radius:var(--r);cursor:pointer;color:var(--mute);font-size:13px;border:0;background:none;width:100%;text-align:left}
.pitem:hover{background:var(--card2);color:var(--ink)}
.pitem.on{background:var(--card2);color:var(--ink);box-shadow:inset 2px 0 0 var(--acc)}
.pitem .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pitem .st{font-size:12px;white-space:nowrap}
.st-done{color:var(--ok)}.st-running{color:var(--acc)}.st-failed{color:var(--bad)}.st-paused{color:var(--warn)}.st-created{color:var(--faint)}
.side-foot{display:flex;gap:8px;align-items:center;border-top:1px solid var(--line);padding-top:12px}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:3px 9px;border-radius:999px;border:1px solid var(--line2);color:var(--mute);white-space:nowrap}
.chip.acc{border-color:var(--acc-line);color:var(--acc);background:var(--acc-soft)}

/* ---------- 主区 ---------- */
.main{min-width:0;padding:32px 36px 56px}
.wrap{max-width:1080px;margin:0 auto}
h1{font:700 30px/1.2 var(--display);margin:0 0 8px;letter-spacing:-.4px;text-wrap:balance}
.lead{color:var(--mute);margin:0 0 24px;max-width:62ch}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:20px}
.card+.card{margin-top:14px}
.card h3,.h3{margin:0 0 14px;font:700 16px/1.3 var(--display);display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.muted{color:var(--mute)}.faint{color:var(--faint)}.small{font-size:13px}
.err{color:var(--bad);font-size:13px;margin-top:8px;min-height:1px}

/* 三步流程条（新建页） */
.steps{list-style:none;margin:0 0 24px;padding:0;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.steps li{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;background:var(--card)}
.steps li+li{border-left:1px solid var(--line)}
.steps .num{font:700 22px/1 var(--display);color:var(--faint);min-width:22px}
.steps b{display:block;font-weight:700}
.steps .note{font-size:13px;color:var(--mute)}
.steps .free{color:var(--ok)}.steps .paid{color:var(--warn)}
.steps li.cur{background:var(--acc-soft);box-shadow:inset 0 -2px 0 var(--acc)}
.steps li.cur .num{color:var(--acc)}
.steps li.done .num{color:var(--ok)}

.tabs{display:inline-flex;gap:2px;padding:3px;background:var(--card2);border:1px solid var(--line);border-radius:10px;margin-bottom:14px;max-width:100%;overflow-x:auto}
.tabs button{border:0;background:none;min-height:36px;padding:0 14px;border-radius:7px;color:var(--mute);cursor:pointer;font-weight:500;white-space:nowrap}
.tabs button:hover{color:var(--ink)}
.tabs button.on{background:var(--ink);color:#0c0f0d;font-weight:700}

.drop{display:block;border:1.5px dashed var(--line2);border-radius:var(--r-lg);padding:32px 16px;text-align:center;cursor:pointer;background:rgba(255,231,178,.025)}
.drop:hover,.drop.over,.drop:focus-within{border-color:var(--acc);background:var(--acc-soft)}
.drop .ic{width:44px;height:44px;margin:0 auto 10px;border-radius:10px;background:var(--card2);display:grid;place-items:center;color:var(--acc)}
.drop .ic .ico{width:22px;height:22px}
.drop b{display:block;font-weight:700;margin-bottom:4px}
.filebar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.eps{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 0}
textarea,input,select{width:100%;min-height:var(--hit);padding:8px 11px;background:var(--card2);border:1px solid var(--line);border-radius:var(--r)}
textarea:focus,input:focus,select:focus{border-color:var(--acc-line)}
textarea{resize:vertical;min-height:120px;line-height:1.7}
textarea.script{min-height:300px;font-size:13px}
label.l{display:block;font-size:13px;color:var(--mute);margin:0 0 6px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.seg{display:flex;gap:6px}
.seg button{flex:1;min-height:var(--hit);border-radius:var(--r);border:1px solid var(--line);background:var(--card2);color:var(--mute);cursor:pointer;font-family:var(--display)}
.seg button.on{border-color:var(--acc);color:var(--acc);background:var(--acc-soft)}
.opt{display:flex;gap:10px;align-items:flex-start;padding:14px;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--card2);cursor:pointer}
.opt input{width:auto;min-height:0;margin-top:4px;accent-color:var(--acc)}
.opt.on{border-color:var(--acc-line);background:var(--acc-soft)}
.opt b{display:block;font-weight:700;margin-bottom:2px}
.cta{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:20px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:var(--hit);padding:0 14px;border-radius:var(--r);border:1px solid var(--line2);background:var(--card2);color:var(--ink);cursor:pointer;font-weight:500;text-decoration:none;font-size:13px;white-space:nowrap}
.btn:hover{border-color:rgba(238,242,236,.32)}
.btn.acc{background:var(--acc);color:var(--acc-ink);border-color:var(--acc);font-weight:700}
.btn.acc:hover{background:#e0ff70}
.btn.big{min-height:46px;padding:0 24px;font-size:15px}
.btn:disabled{opacity:.45;cursor:not-allowed}

/* ---------- 项目工作台 ---------- */
.phead{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:20px}
.phead h1{font-size:26px;margin:0 0 4px}
.meta{font-size:13px;color:var(--faint);margin:0 0 6px}
.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:3px 10px;border-radius:999px;border:1px solid var(--line2);color:var(--mute);white-space:nowrap}
.pill.done{color:var(--ok);border-color:rgba(91,228,155,.4)}.pill.running{color:var(--acc);border-color:var(--acc-line)}
.pill.failed{color:var(--bad);border-color:rgba(255,107,94,.45)}.pill.paused{color:var(--warn);border-color:rgba(255,181,71,.45)}
.pill .ico{width:12px;height:12px}

/* 制作流程轨道：五个阶段连成一条线 */
.track{list-style:none;margin:0 0 6px;padding:0;display:grid;grid-template-columns:repeat(5,1fr)}
.track li{position:relative;padding:0 10px 0 0}
.track li::before{content:"";position:absolute;left:26px;right:0;top:13px;height:2px;background:var(--line2)}
.track li:last-child::before{display:none}
.track li.done::before{background:var(--ok)}
.track .node{position:relative;z-index:1;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font:700 13px/1 var(--display);background:var(--card2);border:1px solid var(--line2);color:var(--faint)}
.track li.done .node{background:var(--ok);border-color:var(--ok);color:#06140c}
.track li.cur .node{background:var(--acc);border-color:var(--acc);color:var(--acc-ink)}
.track li.fail .node{background:var(--bad);border-color:var(--bad);color:#1a0604}
.track li.off{opacity:.55}
.track b{display:block;margin:8px 0 2px;font-weight:700}
.track .sub{font-size:12px;color:var(--faint);line-height:1.6}
.track .sub .d{color:var(--ok)}.track .sub .c{color:var(--acc)}.track .sub .f{color:var(--bad)}
.bar{height:3px;background:var(--card2);border-radius:2px;overflow:hidden;margin:14px 0 16px}
.bar i{display:block;height:100%;background:var(--acc);width:0;transition:width .5s ease}
.callout{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:14px 16px;border-radius:var(--r-lg);border:1px solid var(--acc-line);background:var(--acc-soft);margin-bottom:16px}
.callout.quiet{border-color:var(--line2);background:var(--card)}
.callout.bad{border-color:rgba(255,107,94,.45);background:rgba(255,107,94,.07)}

/* 集卡片：9:16 竖幅，出片后显示该集真实画面 */
.strip-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:4px 0 10px}
.strip{display:grid;grid-auto-flow:column;grid-auto-columns:172px;gap:14px;overflow-x:auto;padding:2px 2px 12px;margin:0 -2px 18px;scroll-snap-type:x proximity}
.ep{scroll-snap-align:start;display:flex;flex-direction:column;gap:8px;min-width:0}
.ep .frame{position:relative;aspect-ratio:9/16;border-radius:var(--r-tile);overflow:hidden;background:#0e0b07;border:1px solid var(--line)}
.ep .frame video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ep .frame::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(5,7,6,.85))}
.ep .no{position:absolute;left:10px;bottom:6px;z-index:1;font:700 44px/1 var(--display);letter-spacing:-1.5px;color:var(--ink)}
.ep .state{position:absolute;left:10px;top:10px;z-index:1}
.ep.done .frame{border-color:rgba(91,228,155,.45)}
.ep.running .frame{border-color:var(--acc)}
.ep .ttl{font-weight:700;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.8em}
.ep .info{font-size:12px;color:var(--faint);display:flex;flex-wrap:wrap;gap:4px 10px}
.ep .row{display:flex;gap:6px}
.ep .row .btn{flex:1;padding:0 8px}

.kv{display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font-size:13px}
.kv>span:nth-child(odd){color:var(--mute)}
.eplist{display:flex;flex-direction:column;gap:8px}
.eprow{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border:1px solid var(--line);border-radius:var(--r);background:var(--card2);flex-wrap:wrap}
.eprow.on{border-color:var(--acc-line)}
.assets{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;align-items:start}
.asset{background:var(--card2);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.asset .img{aspect-ratio:16/10;background:#0e0b07;display:grid;place-items:center;color:var(--faint);font-size:12px;position:relative;overflow:hidden}
.asset .img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.asset .meta2{padding:10px 12px}
.asset .meta2 b{font-weight:700}
.asset summary{cursor:pointer;min-height:32px;display:flex;align-items:center}
.segs{display:flex;flex-direction:column;gap:10px}
.segrow{display:grid;grid-template-columns:180px 1fr;gap:16px;background:var(--card2);border:1px solid var(--line);border-radius:var(--r-lg);padding:12px}
.segrow video,.segrow .ph-v{width:100%;aspect-ratio:9/16;max-height:320px;border-radius:var(--r-tile);background:#000;object-fit:contain}
.segrow .ph-v{display:grid;place-items:center;color:var(--faint);font-size:12px;background:#0e0b07}
.segrow pre{margin:8px 0 0;white-space:pre-wrap;font:12px/1.65 var(--mono);color:var(--mute);max-height:180px;overflow:auto}
.segid{font:700 15px/1 var(--display)}
.player{display:grid;grid-template-columns:minmax(0,360px) 1fr;gap:18px;align-items:start}
.player video{width:100%;border-radius:var(--r-lg);background:#000;max-height:72vh}
.log{font:12px/1.7 var(--mono);background:#090704;border:1px solid var(--line);border-radius:var(--r-lg);padding:12px;height:360px;overflow:auto;white-space:pre-wrap;color:var(--mute)}
.empty{padding:40px 16px;text-align:center;color:var(--faint)}
.hide{display:none!important}

dialog{background:var(--card);color:var(--ink);border:1px solid var(--line2);border-radius:var(--r-lg);padding:22px;width:min(560px,calc(100vw - 32px))}
dialog::backdrop{background:rgba(4,6,5,.7)}
dialog h3{font:700 18px/1.3 var(--display);margin:0 0 6px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:50;max-width:min(560px,calc(100vw - 32px));padding:12px 16px;border-radius:var(--r);background:var(--card2);border:1px solid var(--line2);box-shadow:0 8px 24px rgba(0,0,0,.4);font-size:13px}
.toast.bad{border-color:rgba(255,107,94,.55);color:#ffd0cb}
.toast.ok{border-color:rgba(91,228,155,.5)}

@media (max-width:900px){
  .app{grid-template-columns:1fr}
  .side{position:static;height:auto;border-right:0;border-bottom:1px solid var(--line)}
  .plist{max-height:168px}
  .main{padding:22px 16px 44px}
  .grid{grid-template-columns:1fr 1fr}
  .steps{grid-template-columns:1fr}
  .steps li+li{border-left:0;border-top:1px solid var(--line)}
  .track{grid-template-columns:repeat(5,minmax(96px,1fr));overflow-x:auto;padding-bottom:6px}
  .player,.segrow{grid-template-columns:1fr}
  .segrow video,.segrow .ph-v{max-height:360px}
  h1{font-size:25px}
}
@media (max-width:520px){.grid,.grid2{grid-template-columns:1fr}.strip{grid-auto-columns:150px}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}

/* ---------- Vimo Studio 工作台主题 ---------- */
:root{
  --bg:#080706;--side:#0d0b08;--card:#15120d;--card2:#1e1910;--line:rgba(255,231,178,.11);--line2:rgba(255,231,178,.20);
  --ink:#faf6ec;--mute:rgba(250,246,236,.70);--faint:rgba(250,246,236,.52);
  --acc:#d6ad5b;--acc-ink:#1a1004;--acc-soft:rgba(214,173,91,.14);--acc-line:rgba(214,173,91,.52);
  --ok:#8bd7ae;--bad:#ff8175;--warn:#e2b75e;
  --r-tile:12px;--r:12px;--r-lg:18px;--hit:42px;
}
body{background:radial-gradient(circle at 76% -10%,rgba(176,126,38,.24),transparent 36%),linear-gradient(135deg,#080706 0%,#100d08 48%,#070605 100%)}
.app{grid-template-columns:188px minmax(0,1fr)}
.side{background:rgba(13,11,8,.90);border-right:1px solid rgba(255,231,178,.09);padding:20px 12px;gap:18px;backdrop-filter:blur(18px)}
.brand{gap:9px;padding:0 8px;font-size:15px;letter-spacing:.1px}.brand .logo{width:32px;height:32px;border-radius:10px;background:none;color:inherit;overflow:hidden;box-shadow:0 6px 18px rgba(117,77,16,.32)}.brand .logo img{width:100%;height:100%;object-fit:cover;display:block}
.btn-new{background:#f5f3ff;color:#181326;border-radius:12px;min-height:44px;box-shadow:0 8px 24px rgba(3,4,12,.28)}.btn-new:hover{background:#fff}
.nav{gap:5px}.nav button{min-height:44px;border-radius:12px;padding:0 12px;color:var(--mute);transition:background .2s,color .2s,transform .2s}.nav button:hover{background:rgba(255,255,255,.06);color:var(--ink);transform:translateX(2px)}.nav button.on{background:linear-gradient(90deg,rgba(214,173,91,.22),rgba(214,173,91,.08));color:var(--ink);box-shadow:inset 2px 0 0 var(--acc)}
.nav button .ico{width:18px;height:18px}.sec-t{padding:0 12px;text-transform:uppercase;letter-spacing:.12em;font-size:10px;color:var(--faint)}
.plist{margin:0 -2px;padding:0 2px}.pitem{border-radius:10px;min-height:38px;padding:4px 10px}.pitem.on{box-shadow:inset 2px 0 0 var(--acc);background:rgba(173,153,255,.12)}
.side-foot{padding:14px 4px 0}.side-foot .btn{min-height:38px;border-radius:10px}.side-foot .chip{display:none}
.main{padding:32px 42px 64px}.wrap{max-width:1180px}
 .main{position:relative}.topbar{position:fixed;top:18px;right:28px;z-index:20;display:flex;align-items:center;gap:8px;color:var(--faint);font-size:12px}.lang-switch{min-height:34px;padding:0 12px;border:1px solid var(--acc-line);border-radius:999px;background:var(--acc-soft);color:var(--acc);font-weight:700;cursor:pointer;letter-spacing:.02em}.lang-switch:hover{background:var(--acc);color:var(--acc-ink)}
