function overview(p){const b=p.bible||{},brief=p.brief||{};
  const rv=p.review?Object.entries(p.review).map(([k,v])=>{const r=(v.rounds||[]).slice(-1)[0]||{};return `<div class="eprow"><span>${esc(k)}　<b>${esc(r.total??'-')}</b> 分</span><span class="muted small" style="flex:1;min-width:200px">${esc((r.notes||[]).slice(0,2).join('；'))}</span></div>`}).join(''):'';
  return `<div class="grid2" style="align-items:start">
   <div class="card"><h3>${t('projectInfo')}</h3><div class="kv">
     <span>${t('stylePrefix')}</span><span>${esc(b.style?.name||brief.style||'—')}${b.style?.prefix?`<br><span class="faint small">${esc(b.style.prefix)}</span>`:''}</span>
     <span>${t('aspect')}</span><span>${esc(brief.ratio||'—')}</span><span>${t('episodeCount')}</span><span>${esc(brief.episodes||'—')}</span>
     <span>${t('genre')}</span><span>${esc(b.genre||'—')}</span><span>${t('characters')}</span><span>${esc((b.characters||[]).map(c=>c.name).join('、')||'—')}</span>
     <span>${t('scenes')}</span><span>${esc((b.scenes||[]).map(s=>s.name).join('、')||'—')}</span>
     ${p.qc?`<span>${t('qc')}</span><span>P0 ${p.qc.P0}，P1 ${p.qc.P1}，P2 ${p.qc.P2}</span>`:''}</div></div>
   <div class="card"><h3>${t('reviewBoard')}</h3>${rv?`<div class="eplist">${rv}</div>`:`<p class="faint" style="margin:0">${t('reviewEmpty')}</p>`}</div></div>`}

function assetsView(p){if(!p.assets.length)return `<div class="card empty">${t('assetEmpty')}</div>`;
  return `<div class="assets">${p.assets.map(a=>`<div class="asset"><div class="img">${a.file?`<img loading="lazy" src="${q(`/api/projects/${p.id}/files/${a.file}`)}" alt="${esc(a.name)} ${t('assetPrompt')}">` :(p.stage==='asset_images'&&p.state==='running'?t('outImage'):t('notGenerated'))}</div>
    <div class="meta2"><b>${esc(a.name)}</b> <span class="faint small">${a.kind==='character'?t('character'):a.kind==='scene'?t('scene'):t('prop')}，${esc(a.ref)}</span>
    <details class="small muted" style="margin-top:4px"><summary>${t('assetPrompt')}</summary>${esc(a.prompt)}</details></div></div>`).join('')}</div>`}

function storyView(p){if(!p.segments.length)return `<div class="card empty">${t('promptEmpty')}</div>`;
  return `<div class="segs">${p.segments.map(s=>`<div class="segrow">
    ${s.video?`<video controls preload="metadata" playsinline src="${q(`/api/projects/${p.id}/files/${s.video}`)}" aria-label="${esc(s.id)} ${t('video')}"></video>`:`<div class="ph-v">${p.stage==='render'&&p.state==='running'?t('running'):t('notGenerated')}</div>`}
    <div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span class="segid">${esc(s.id)}</span><span class="chip">${s.duration} ${t('secondsUnit')}</span>${s.refs.map(r=>`<span class="chip">${esc(r)}</span>`).join('')}</div>
    <pre tabindex="0">${esc(s.prompt)}</pre></div></div>`).join('')}</div>`}

function videoView(p){const fin=p.final;
  if(!fin||!fin.episodes){const done=p.segments.filter(s=>s.video).length;
    return `<div class="card empty">${p.segments.length?t('videoPartial',{done,total:p.segments.length}):t('videoEmpty')}</div>`}
  const ep=fin.episodes[curEp]||fin.episodes[0];
  return `<div class="player"><video id="player" controls playsinline src="${q(`/api/projects/${p.id}/files/${ep.video}`)}" aria-label="${t('episode',{n:ep.no})} ${t('video')}"></video>
   <div class="eplist">${fin.episodes.map((e,i)=>`<div class="eprow ${i===curEp?'on':''}"><span>${t('episode',{n:e.no})}</span><span class="actions"><button class="btn" onclick="playEp(${i})">${icon('play','width:14px;height:14px')}${t('play')}</button><a class="btn" href="${q(`/api/projects/${p.id}/files/${e.video}`)}" download>${t('downloadMp4')}</a><a class="btn" href="${q(`/api/projects/${p.id}/files/${e.srt}`)}" download>${t('downloadSrt')}</a></span></div>`).join('')}</div></div>`}
function playEp(i){curEp=i;renderProject();const v=$('#player');if(v)v.play()}

/* 按集出片：段数、时长、还需新出的资产图 */
function epCost(p,eps){const segs=p.segments.filter(s=>eps.includes(s.episode)&&!s.video);
  const names=new Set(segs.flatMap(s=>s.refs));const imgs=p.assets.filter(a=>names.has(a.name)&&!a.file).length;
  return {segs:segs.length,secs:segs.reduce((t,s)=>t+s.duration,0),imgs}}
/* 生成视频对话框：选模型与清晰度，显示段数、生成秒数与参考价 */
async function renderEps(eps){const p=proj;const list=eps||[...new Set(p.segments.map(s=>s.episode))].filter(e=>!((p.final&&p.final.episodes)||[]).some(f=>f.no===e));
  const c=epCost(p,list);let info;
  try{info=await api(`/api/video-models?pid=${p.id}&episodes=${list.join(',')}`)}catch(e){toast(e.message,'bad');return}
  if(!info.models.length){toast(t('noModel'),'bad');return}
  const prevModel=(p.request&&p.request.video_model)||info.default_model, prevRes=(p.request&&p.request.video_resolution)||info.default_resolution;
  const dlg=document.getElementById('renderDlg');
  const msel=dlg.querySelector('#dlgModel'),rsel=dlg.querySelector('#dlgRes'),sum=dlg.querySelector('#dlgSum');
  msel.innerHTML=info.models.map(m=>`<option value="${esc(m.id)}">${esc(m.id)}${m.label?'（'+esc(m.label)+'）':''}</option>`).join('');
  msel.value=info.models.some(m=>m.id===prevModel)?prevModel:info.models[0].id;
  const fill=()=>{const m=info.models.find(x=>x.id===msel.value);const keep=rsel.value||prevRes;
    rsel.innerHTML=m.resolutions.map(r=>`<option>${r}</option>`).join('');rsel.value=m.resolutions.includes(keep)?keep:m.default_resolution;upd()};
  const upd=()=>{const m=info.models.find(x=>x.id===msel.value);const est=m.estimates[rsel.value];const epLabel=list.map(n=>t('episode',{n})).join(lang==='en'?', ': '、');const billing=lang==='en'?(m.billing==='second'?'per second':'per item'):(m.billing==='second'?'按秒计费':'按条计费');const price=est!=null?(lang==='en'?'Approx. ¥':'约 ¥')+est:(lang==='en'?'No estimate for this resolution':'暂无该清晰度参考价');sum.innerHTML=lang==='en'?('Episodes '+epLabel+': '+c.segs+' video clips, '+c.secs+' storyboard seconds, '+m.gen_seconds+' seconds generated. '+m.id+': '+m.min+'–'+m.max+' sec per clip.<br>'+c.imgs+' new asset images. Reference price: '+price+' ('+billing+')<br><span class="faint">'+esc(m.note||'')+'. '+esc(info.price_note)+'</span>'):('第 '+list.join('、')+' 集：'+c.segs+' 段视频，分镜共 '+c.secs+' 秒，实际生成 '+m.gen_seconds+' 秒。'+m.id+' 每段 '+m.min+' 到 '+m.max+' 秒。<br>新出资产图 '+c.imgs+' 张。视频参考价：'+price+'（'+billing+'）<br><span class="faint">'+esc(m.note||'')+'。'+esc(info.price_note)+'</span>');};
  msel.onchange=fill;rsel.onchange=upd;rsel.value='';fill();
  dlg.querySelector('#dlgGo').onclick=async()=>{dlg.close();
    try{await api(`/api/projects/${current}/render`,{method:'POST',body:JSON.stringify({episodes:eps,model:msel.value,resolution:rsel.value})});toast(t('startEpisode',{eps:list.join(lang==='en'?', ': '、')}),'ok');tab='storyboard';openProject(current)}catch(e){toast(e.message,'bad')}};
  dlg.showModal()}
async function resumeJob(){try{await api(`/api/projects/${current}/resume`,{method:'POST',body:JSON.stringify({})});toast(t('resumable'),'ok');openProject(current)}catch(e){toast(e.message,'bad')}}
async function cancelJob(){try{await api(`/api/projects/${current}/cancel`,{method:'POST'});toast(t('cancelled'),'ok');openProject(current)}catch(e){toast(e.message,'bad')}}

function canvasMenuGuard(){const menu=$('#canvasNodeMenu');if(!menu)return;$$('#canvasNodeMenu [data-canvas-create]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();const r=menu.getBoundingClientRect();const p=canvasScreenToGraph(r.left+24,r.top+70);canvasCreate(b.dataset.canvasCreate,p.x,p.y);canvasCloseMenu()},true))}
initCanvas();
canvasMenuGuard();
api('/healthz').then(h=>{$('#profile').textContent=h.profile||'default';if(h.profile==='mock')$('#profile').classList.add('acc')}).catch(()=>{});
loadList();setInterval(loadList,15000);
const initialHash=location.hash.slice(1);
if(initialHash&&PAGE_NAV.includes(initialHash))showPage(initialHash);else if(initialHash)openProject(initialHash);else showPage('home');
</script>
</body>
