    const state=f?'<span class="pill done">'+icon('check')+t('out')+'</span>':rendering?'<span class="pill running">'+t('running')+' '+segDone+'/'+segN+'</span>':segDone?'<span class="pill paused">'+segDone+'/'+segN+' '+t('segment',{done:segDone,total:segN}).replace(segDone+'/'+segN+' ','')+'</span>':'';
