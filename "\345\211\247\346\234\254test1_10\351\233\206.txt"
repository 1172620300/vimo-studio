    const secs=(sc&&sc.target_seconds)||e.seconds;const main=f?'<button class="btn" onclick="tab=\'video\';curEp='+fin.indexOf(f)+';renderProject()">'+icon('play','width:14px;height:14px')+t('play')+'</button>':p.segments.length?(rendering?'<button class="btn" disabled>'+t('running')+'</button>':'<button class="btn acc" '+(p.running?'disabled':'')+' onclick="renderEps(['+e.no+'])">'+t('episodeVideo')+'</button>'):'';
    return '<article class="ep '+(f?'done':rendering?'running':'')+'" aria-label="'+t('episode',{n:e.no})+'"><div class="frame">'+(cover?'<video muted playsinline preload="metadata" src="'+q('/api/projects/'+p.id+'/files/'+cover)+'#t=0.8" aria-hidden="true" tabindex="-1"></video>':'')+'<span class="state">'+state+'</span><span class="no" aria-hidden="true">'+String(e.no).padStart(2,'0')+'</span></div><div class="ttl" title="'+esc(sc&&sc.title||e.title||'')+'">'+esc(sc&&sc.title||e.title||t('episode',{n:e.no}))+'</div><div class="info">'+(secs?'<span>'+secs+' '+t('secondsUnit')+'</span>':'')+(ck?'<span>'+t('dialogue',{n:ck.dialogue_chars})+'</span>':'')+chk+'</div><div class="row">'+main+(sc&&sc.md?'<a class="btn" target="_blank" rel="noopener" href="'+q('/api/projects/'+p.id+'/files/'+sc.md)+'" aria-label="'+t('episode',{n:e.no})+' '+t('script')+'">'+t('scriptFile')+'</a>':'')+'</div></article>'}).join('');
