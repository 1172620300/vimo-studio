   ${p.state==='running'&&p.stage_started?`<div class="callout quiet"><div><b>${lang==='en'?'In progress:':'正在进行：'}${esc(STAGE_LONG[p.stage]||p.stage)}</b> <span class="muted small" id="elapsed" data-t="${p.stage_started}"></span><div class="muted small">${esc(p.stage_message||STAGE_TIP[p.stage]||'')}</div></div></div>`:''}
